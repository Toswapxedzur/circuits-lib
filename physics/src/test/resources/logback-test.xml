<?xml version="1.0" encoding="UTF-8"?>
<!--
  Test-time Logback config. Picked up automatically when `logback-test.xml` is on the test classpath,
  shadowing any production `logback.xml`. Kept deliberately quiet (WARN at the root) so JUnit output
  isn't flooded by DEBUG/INFO chatter from the same code under test.
-->
<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="WARN">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
